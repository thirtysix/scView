# scView Configuration

# Data directory (inside Docker containers)
DATA_DIR=/data

# Maximum upload file size in MB, in public mode (DEPLOYMENT_MODE=public) only:
# private mode does not cap uploads (a 10x file of a million cells is 4+ GB)
MAX_UPLOAD_SIZE_MB=2048

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# DeepInfra API key (optional - for LLM-powered analysis suggestions)
# Get one at https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# R Converter service URL (internal Docker network)
CONVERTER_URL=http://converter:8001

# --- Deployment posture (see SECURITY.md) ------------------------------------
# "private" (default) assumes a single trusted user on localhost. Set to "public"
# if you expose scView beyond localhost — it enables input hardening and a startup
# self-check that warns about what's still missing (auth, rate limiting, quotas).
DEPLOYMENT_MODE=private
# Optional shared-secret gate. When set, every /api request must send it as
# `Authorization: Bearer <token>` or `X-Access-Token`. Coarse (one secret for all);
# pair with a reverse proxy for real per-user auth.
ACCESS_TOKEN=
# Always-on input caps for the AI co-pilot.
MAX_QUERY_CHARS=4000
MAX_QUERY_WORDS=400
MAX_HISTORY_MESSAGES=50
MAX_JSON_BODY_KB=512

# MSigDB gene sets (pathway enrichment, gene-set scoring). On first start the
# backend downloads them (~45 MB) from the Broad Institute into a Docker volume;
# see https://www.gsea-msigdb.org/gsea/msigdb_license_terms.jsp for their terms.
# Set to false to skip the download (enrichment then has no gene sets).
MSIGDB_AUTO_DOWNLOAD=true

# Cell-type marker databases (PanglaoDB, CellMarker 3.0 or 2.0, ACT) for the annotation
# cross-check and marker-score annotation, downloaded from their own sites on first
# use (~76 MB with the Cell Ontology). None of them states a licence; check reuse
# terms with the providers.
# Set to false to skip the download (marker-score annotation then uses its 14
# built-in immune sets, and the cross-check's database check is off).
MARKER_DB_AUTO_DOWNLOAD=true

# --- RAG co-pilot (literature + tutorials corpora over pgvector) -------------
# Postgres/Neon connection string with the pgvector extension. Empty disables
# RAG retrieval (the co-pilot still grounds answers in the dataset's own facts).
# Reuse a WntHub-style Neon instance or a fresh DB; vectors are namespaced by a
# `corpus` column so they won't collide with other apps' tables.
RAG_DATABASE_URL=
# DeepInfra models (defaults match the WntHub corpus pipeline).
RAG_EMBED_MODEL=BAAI/bge-base-en-v1.5
RAG_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Most memory (GB) scView's backend and converter may each use. The start scripts
# suggest one (free memory minus 3 GB) on the first start. Empty: no limit, so on
# Linux a dataset too big for the machine can make the whole computer unresponsive.
SCVIEW_MEMORY_GB=

# Datasets whose .h5ad file is larger than this (MB) are opened from disk ("backed"):
# the matrix is read when needed instead of held in memory. Processing one reads it
# into memory first, within SCVIEW_MEMORY_GB. Empty: 2048 (2 GB).
SCVIEW_BACKED_MIN_MB=
